{
  "manifest_version": 3,
  "name": "ProfilePilot 浏览器连接",
  "version": "0.1.0",
  "description": "连接当前 Chrome Profile，在专用新标签页中执行任务，保留已有页面和登录状态。",
  "minimum_chrome_version": "125",
  "host_permissions": ["http://127.0.0.1/*"],
  "content_scripts": [{ "matches": ["http://127.0.0.1/profilepilot-connect/*"], "js": ["onboarding.js"], "run_at": "document_idle" }],
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ProfilePilot 浏览器连接"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:* http://127.0.0.1:*"
  },
  "key": ""
}
